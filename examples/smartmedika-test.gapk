package smartmedika

// Test new gapk features: http_post, json_get, storage_set/get, headers
app "SmartMedika Test" [theme: "light", primary: "#0E6B5C"] {
    nisn := ""
    password := ""
    token := ""
    apiResponse := ""
    loginStatus := ""

    screen "Login" [padding: 24] {
        column [spacing: 16] {
            text "SmartMedika Portal" [size: 24, weight: "bold", color: "#0E6B5C"]
            text "Login dengan NISN" [size: 14, color: "#666666"]

            input nisn "NISN" [hint: "Masukkan NISN"]
            input password "Password" [hint: "Masukkan password"]

            button "Login" [bg: "#0E6B5C"] {
                http_post "https://smartmedika-backend.vercel.app/api/auth/login" "{\"identifier\": \"" + nisn + "\", \"password\": \"" + password + "\"}" into apiResponse
                json_get apiResponse "data.token" into token
                storage_set "auth_token" token
                if token != "" {
                    loginStatus = "Login berhasil!"
                    navigate "Home"
                } else {
                    loginStatus = "Login gagal"
                }
            }

            text loginStatus [size: 14, color: "#FF0000"]
        }
    }

    screen "Home" [padding: 16] {
        appbar "Beranda" [center: true] {
        }

        column [spacing: 12] {
            text "Selamat datang!" [size: 20, weight: "bold"]

            button "Load Materi" [bg: "#0E6B5C"] {
                storage_get "auth_token" into token
                http_get "https://smartmedika-backend.vercel.app/api/materi" into apiResponse [header_Authorization: "Bearer " + token]
                snackbar "Materi dimuat"
            }

            button "Logout" [variant: "outlined"] {
                storage_set "auth_token" ""
                token = ""
                navigate "Login"
            }
        }

        bottom_nav {
            nav_item "Home" "home" "Home"
            nav_item "Profil" "person" "Home"
        }
    }
}
